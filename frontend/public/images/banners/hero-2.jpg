<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="500" viewBox="0 0 1200 500">
    <defs>
      <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#be185d" />
        <stop offset="100%" stop-color="#f59e0b" />
      </linearGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#bg)" />
    <rect width="100%" height="100%" fill="url(#grid)" />
    <circle cx="960" cy="150" r="180" fill="rgba(255,255,255,0.12)" />
    <circle cx="240" cy="400" r="240" fill="rgba(0,0,0,0.12)" />
    <g transform="translate(96, 225)">
      <text fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="38" font-weight="800">Summer Fashion & Lifestyle</text>
      <text y="45" fill="rgba(255,255,255,0.85)" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="500">Exclusive Arrivals for Trendsetters</text>
    </g>
  </svg>